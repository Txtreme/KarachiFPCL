#pragma kernel KernelIntegrate
#pragma kernel KernelSolveFEM
#pragma kernel KernelApplyDeltas
#pragma kernel KernelPostPhysics
#pragma kernel KernelParticleCollisions
#pragma kernel KernelBladeInteraction
#pragma kernel KernelInterBodyCollisions

struct Tetrahedron
{
    int v0, v1, v2, v3;
    float restVolume;
    int active;
};

struct GPUMatrix3x3
{
    float m00, m01, m02;
    float m10, m11, m12;
    float m20, m21, m22;
};

float3x3 ToFloat3x3(GPUMatrix3x3 m)
{
    return float3x3(
        m.m00, m.m10, m.m20,
        m.m01, m.m11, m.m21,
        m.m02, m.m12, m.m22
    );
}

// Buffers
RWStructuredBuffer<float3> positionsBuffer;
RWStructuredBuffer<float3> prevPositionsBuffer;
RWStructuredBuffer<float3> velocitiesBuffer;
StructuredBuffer<float> invMassesBuffer;

StructuredBuffer<Tetrahedron> tetsBuffer;
StructuredBuffer<GPUMatrix3x3> invRestMatricesBuffer;

RWStructuredBuffer<int3> deltaPosIntBuffer;
RWStructuredBuffer<int> deltaCountBuffer;

// Inter-Body Collision Buffers
StructuredBuffer<float3> otherPositionsBuffer;
uint numOtherVertices;

// Parameters
uint numVertices;
uint numTets;
float dt;
float mu;
float lambda;
float damping;
float3 gravity;
float maxDisplacement;
float floorY;
int enableFloorCollision;

// Collision & Blade Interaction Parameters
float particleRadius;
float3 bladeStart;
float3 bladeEnd;
float bladeRadius;
float bladeForce;
int isBladeActive;

#define SCALE_FACTOR 100000.0f

// --- Helper Matrix Math Functions ---

float3x3 Inverse3x3(float3x3 m)
{
    float det = determinant(m);
    if (abs(det) < 1e-7f)
        return float3x3(1, 0, 0, 0, 1, 0, 0, 0, 1);
    float invDet = 1.0f / det;
    float3x3 r;
    r[0][0] = (m[1][1] * m[2][2] - m[1][2] * m[2][1]) * invDet;
    r[0][1] = (m[0][2] * m[2][1] - m[0][1] * m[2][2]) * invDet;
    r[0][2] = (m[0][1] * m[1][2] - m[0][2] * m[1][1]) * invDet;

    r[1][0] = (m[1][2] * m[2][0] - m[1][0] * m[2][2]) * invDet;
    r[1][1] = (m[0][0] * m[2][2] - m[0][2] * m[2][0]) * invDet;
    r[1][2] = (m[0][2] * m[1][0] - m[0][0] * m[1][2]) * invDet;

    r[2][0] = (m[1][0] * m[2][1] - m[1][1] * m[2][0]) * invDet;
    r[2][1] = (m[0][1] * m[2][0] - m[0][0] * m[2][1]) * invDet;
    r[2][2] = (m[0][0] * m[1][1] - m[0][1] * m[1][0]) * invDet;
    return r;
}

float3x3 ExtractRotation(float3x3 F)
{
    float detF = determinant(F);

    if (!isfinite(detF) || abs(detF) < 1e-6f)
    {
        return float3x3(1, 0, 0, 0, 1, 0, 0, 0, 1);
    }

    float3x3 R = F;

    for (int iter = 0; iter < 7; iter++)
    {
        float detR = determinant(R);
        if (!isfinite(detR) || abs(detR) < 1e-6f)
            break;

        float omega = pow(abs(detR), -1.0f / 3.0f);
        omega = clamp(omega, 0.5f, 2.0f);

        float3x3 invR = Inverse3x3(R);
        float3x3 invT = transpose(invR);

        R = 0.5f * (omega * R + (1.0f / omega) * invT);
    }

    if (determinant(R) < 0.0f)
    {
        R[0][2] = -R[0][2];
        R[1][2] = -R[1][2];
        R[2][2] = -R[2][2];
    }

    if (!all(isfinite(R[0])) || !all(isfinite(R[1])) || !all(isfinite(R[2])))
    {
        return float3x3(1, 0, 0, 0, 1, 0, 0, 0, 1);
    }

    return R;
}

void AtomicAddDelta(uint vIdx, float3 delta)
{
    if (!all(isfinite(delta)))
        return;

    float limit = maxDisplacement > 0.0f ? maxDisplacement : 2.0f;
    float3 safeDelta = clamp(delta, -limit, limit);
    int3 dInt = (int3) (safeDelta * SCALE_FACTOR);
    dInt = clamp(dInt, -500000000, 500000000);

    InterlockedAdd(deltaPosIntBuffer[vIdx].x, dInt.x);
    InterlockedAdd(deltaPosIntBuffer[vIdx].y, dInt.y);
    InterlockedAdd(deltaPosIntBuffer[vIdx].z, dInt.z);
    InterlockedAdd(deltaCountBuffer[vIdx], 1);
}

// --- Kernels ---

[numthreads(64, 1, 1)]
void KernelIntegrate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numVertices)
        return;

    if (invMassesBuffer[id.x] > 0.0f)
    {
        velocitiesBuffer[id.x] += gravity * dt;
        velocitiesBuffer[id.x] *= (1.0f - damping);
        prevPositionsBuffer[id.x] = positionsBuffer[id.x];
        positionsBuffer[id.x] += velocitiesBuffer[id.x] * dt;
    }

    deltaPosIntBuffer[id.x] = int3(0, 0, 0);
    deltaCountBuffer[id.x] = 0;
}

[numthreads(64, 1, 1)]
void KernelBladeInteraction(uint3 id : SV_DispatchThreadID)
{
    uint idX = id.x;
    if (idX >= numVertices || invMassesBuffer[idX] <= 0.0f || isBladeActive == 0)
        return;

    float3 pos = positionsBuffer[idX];
    float3 AB = bladeEnd - bladeStart;
    float ab2 = dot(AB, AB);
    if (ab2 < 0.00001f)
        return;

    float t = saturate(dot(pos - bladeStart, AB) / ab2);
    float3 closestPoint = bladeStart + t * AB;

    float3 pushDir = pos - closestPoint;
    float dist = length(pushDir);

    if (dist < bladeRadius && dist > 0.0001f)
    {
        pushDir /= dist;
        float penetration = bladeRadius - dist;
        positionsBuffer[idX] += pushDir * penetration * bladeForce;
    }
}

[numthreads(64, 1, 1)]
void KernelParticleCollisions(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= numVertices || invMassesBuffer[i] <= 0.0f)
        return;

    float3 posA = positionsBuffer[i];
    float minDist = particleRadius * 2.0f;
    float3 delta = float3(0, 0, 0);
    int count = 0;

    for (uint j = 0; j < numVertices; j++)
    {
        if (i == j)
            continue;

        float3 posB = positionsBuffer[j];
        float3 diff = posA - posB;
        float distSq = dot(diff, diff);

        if (distSq < minDist * minDist && distSq > 0.00001f)
        {
            float dist = sqrt(distSq);
            float3 norm = diff / dist;
            float overlap = (minDist - dist) * 0.5f;

            delta += norm * overlap;
            count++;
        }
    }

    if (count > 0)
    {
        AtomicAddDelta(i, delta / (float) count);
    }
}

[numthreads(64, 1, 1)]
void KernelInterBodyCollisions(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= numVertices || invMassesBuffer[i] <= 0.0f)
        return;

    float3 posA = positionsBuffer[i];
    float minDist = particleRadius * 2.0f;
    float3 delta = float3(0, 0, 0);
    int count = 0;

    for (uint j = 0; j < numOtherVertices; j++)
    {
        float3 posB = otherPositionsBuffer[j];
        float3 diff = posA - posB;
        float distSq = dot(diff, diff);

        if (distSq < minDist * minDist && distSq > 0.00001f)
        {
            float dist = sqrt(distSq);
            float3 norm = diff / dist;
            float overlap = (minDist - dist) * 0.5f;

            delta += norm * overlap;
            count++;
        }
    }

    if (count > 0)
    {
        AtomicAddDelta(i, delta / (float) count);
    }
}

[numthreads(64, 1, 1)]
void KernelSolveFEM(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numTets)
        return;

    Tetrahedron tet = tetsBuffer[id.x];
    if (tet.active == 0)
        return;

    float3 x0 = positionsBuffer[tet.v0];
    float3 x1 = positionsBuffer[tet.v1];
    float3 x2 = positionsBuffer[tet.v2];
    float3 x3 = positionsBuffer[tet.v3];

    float3 Ds0 = x1 - x0;
    float3 Ds1 = x2 - x0;
    float3 Ds2 = x3 - x0;

    float3x3 Ds = float3x3(
        Ds0.x, Ds1.x, Ds2.x,
        Ds0.y, Ds1.y, Ds2.y,
        Ds0.z, Ds1.z, Ds2.z
    );

    float3x3 invDm = ToFloat3x3(invRestMatricesBuffer[id.x]);
    float vol0 = max(tet.restVolume, 1e-5f);

    float3x3 F = mul(Ds, invDm);

    if (!all(isfinite(F[0])) || !all(isfinite(F[1])) || !all(isfinite(F[2])))
    {
        return;
    }

    float3x3 R = ExtractRotation(F);
    float3x3 P = F - R;

    float w0 = invMassesBuffer[tet.v0];
    float w1 = invMassesBuffer[tet.v1];
    float w2 = invMassesBuffer[tet.v2];
    float w3 = invMassesBuffer[tet.v3];

    // 1. Elastic Strain Correction
    float3 d1 = clamp(invDm[0], -50.0f, 50.0f);
    float3 d2 = clamp(invDm[1], -50.0f, 50.0f);
    float3 d3 = clamp(invDm[2], -50.0f, 50.0f);
    float3 d0 = -(d1 + d2 + d3);

    float alphaStrain = 1.0f / (max(mu, 1e-4f) * vol0 * dt * dt);

    float3 delta_x0 = float3(0, 0, 0);
    float3 delta_x1 = float3(0, 0, 0);
    float3 delta_x2 = float3(0, 0, 0);
    float3 delta_x3 = float3(0, 0, 0);

    for (int j = 0; j < 3; j++)
    {
        float3 P_col = float3(P[0][j], P[1][j], P[2][j]);

        float sumGradSq = w0 * (d0[j] * d0[j]) +
                          w1 * (d1[j] * d1[j]) +
                          w2 * (d2[j] * d2[j]) +
                          w3 * (d3[j] * d3[j]);

        float denom = sumGradSq + alphaStrain;
        if (denom > 1e-7f)
        {
            float3 deltaLambda = -P_col / denom;

            delta_x0 += w0 * deltaLambda * d0[j];
            delta_x1 += w1 * deltaLambda * d1[j];
            delta_x2 += w2 * deltaLambda * d2[j];
            delta_x3 += w3 * deltaLambda * d3[j];
        }
    }

    AtomicAddDelta(tet.v0, delta_x0);
    AtomicAddDelta(tet.v1, delta_x1);
    AtomicAddDelta(tet.v2, delta_x2);
    AtomicAddDelta(tet.v3, delta_x3);

    // 2. Direct Geometric Volume Compression Constraint
    float currentVol = dot(Ds0, cross(Ds1, Ds2)) / 6.0f;
    float C_vol = clamp((currentVol / vol0) - 1.0f, -0.5f, 0.5f);

    float3 g1_v = clamp(cross(Ds1, Ds2) / (6.0f * vol0), -50.0f, 50.0f);
    float3 g2_v = clamp(cross(Ds2, Ds0) / (6.0f * vol0), -50.0f, 50.0f);
    float3 g3_v = clamp(cross(Ds0, Ds1) / (6.0f * vol0), -50.0f, 50.0f);
    float3 g0_v = -(g1_v + g2_v + g3_v);

    float sumGradSq_v = w0 * dot(g0_v, g0_v) + w1 * dot(g1_v, g1_v) + w2 * dot(g2_v, g2_v) + w3 * dot(g3_v, g3_v);
    float alphaVol = 1.0f / (max(lambda, 1e-4f) * vol0 * dt * dt);

    if (sumGradSq_v + alphaVol > 1e-7f)
    {
        float deltaLambda_v = -C_vol / (sumGradSq_v + alphaVol);

        AtomicAddDelta(tet.v0, w0 * deltaLambda_v * g0_v);
        AtomicAddDelta(tet.v1, w1 * deltaLambda_v * g1_v);
        AtomicAddDelta(tet.v2, w2 * deltaLambda_v * g2_v);
        AtomicAddDelta(tet.v3, w3 * deltaLambda_v * g3_v);
    }
}

[numthreads(64, 1, 1)]
void KernelApplyDeltas(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numVertices)
        return;

    int count = deltaCountBuffer[id.x];
    if (count > 0)
    {
        float3 avgDelta = ((float3) deltaPosIntBuffer[id.x] / SCALE_FACTOR) / (float) count;
        float3 candidatePos = positionsBuffer[id.x] + avgDelta;

        if (all(isfinite(candidatePos)))
        {
            positionsBuffer[id.x] = candidatePos;
        }
    }

    deltaPosIntBuffer[id.x] = int3(0, 0, 0);
    deltaCountBuffer[id.x] = 0;
}

[numthreads(64, 1, 1)]
void KernelPostPhysics(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numVertices)
        return;

    if (enableFloorCollision == 1 && positionsBuffer[id.x].y < floorY)
    {
        positionsBuffer[id.x].y = floorY;
    }

    if (invMassesBuffer[id.x] > 0.0f)
    {
        float3 vel = (positionsBuffer[id.x] - prevPositionsBuffer[id.x]) / dt;

        float maxVel = 20.0f;
        float velLen = length(vel);
        if (velLen > maxVel)
        {
            vel = (vel / velLen) * maxVel;
        }

        if (enableFloorCollision == 1 && positionsBuffer[id.x].y <= floorY && vel.y < 0.0f)
        {
            vel.y = 0.0f;
        }

        if (all(isfinite(vel)))
        {
            velocitiesBuffer[id.x] = vel;
        }
    }
}